{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "api": {
      "entrypoint": "frontend/api/main.py",
      "routePrefix": "/api",
      "framework": "fastapi"
    }
  },
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 7 * * *" }
  ]
}
